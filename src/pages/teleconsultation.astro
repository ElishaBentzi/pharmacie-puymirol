---
import BasePage from '../components/BasePage.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { pharmacyData } from '../data/store';

const title = "Téléconsultation | Diagnostic et Traitement Rapides";
const description = "Vous cherchez un accès rapide à un médecin ? Notre pharmacie propose des téléconsultations via la plateforme Medadom.";

const avantages = [
  "Accès immédiat aux soins médicaux : Consultez un médecin sans attendre ni avoir à vous déplacer.",
  "Soins sans rendez-vous : communiquez avec un médecin chaque fois que vous en avez besoin, pendant les heures d’ouverture de la pharmacie.",
  "Variété de spécialités : Accédez à un large éventail de médecins spécialistes dans le confort de la pharmacie.",
  "Service personnalisé : Recevez des soins médicaux personnalisés et de qualité.",
];

const etapes = [
  "Venez à la pharmacie et demandez une téléconsultation.",
  "Notre personnel vous aidera à entrer en contact avec un médecin via un appareil spécial.",
  "Expliquez votre problème au médecin et recevez un diagnostic et un traitement personnalisés.",
  "Le médecin peut vous prescrire des médicaments ou vous donner des instructions pour vos soins.",
];

const zones = [
  "47240 Lafox, France",
  "47270 Tayrac, France",
  "47270 Grayssas, France",
  "47270 Puymirol, France",
  "82400 Perville, France",
  "47700 Casteljaloux, France",
  "47270 Saint-Urcisse, France",
  "47270 Puymirol, La Roche, France",
  "47270 Saint-Romain-le-Noble, France",
  "47270 Puymirol, Saint-Julien, France",
  "47270 Saint-Urcisse, Sainte-Croix, France",
  "47270 Saint-Caprais-de-Lerm, Malbés, France",
];

// FAQPage: respuestas derivadas del contenido existente de la página
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment se déroule une téléconsultation en pharmacie ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Venez à la pharmacie et demandez une téléconsultation : notre personnel vous aide à entrer en contact avec un médecin via un appareil spécial. Vous expliquez votre problème, recevez un diagnostic et un traitement personnalisés, et le médecin peut vous prescrire des médicaments ou vous donner des instructions pour vos soins."
      }
    },
    {
      "@type": "Question",
      "name": "Quels sont les avantages de la téléconsultation en pharmacie ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un accès immédiat aux soins médicaux sans déplacement, des soins sans rendez-vous pendant les heures d'ouverture de la pharmacie, une variété de spécialistes disponibles sur place et un service personnalisé de qualité."
      }
    },
    {
      "@type": "Question",
      "name": "Quelles communes sont couvertes par le service ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le service couvre notamment Puymirol, Lafox, Tayrac, Grayssas, Perville, Casteljaloux, Saint-Urcisse, Saint-Romain-le-Noble et Saint-Caprais-de-Lerm."
      }
    }
  ]
};
---

<BasePage title={title} description={description}>
  <Breadcrumb items={[{ label: 'Téléconsultation' }]} />

  <!-- Banner verde del original -->
  <section class="bg-teal-500 py-10 lg:py-14">
    <div class="container-site text-center" data-aos="fade-up">
      <h1 class="text-5xl font-bold text-white lg:text-[64px] lg:leading-tight">Téléconsultation</h1>
      <h3 class="mt-6 text-left text-[15px] font-bold leading-relaxed text-white lg:text-[17px]">
        Au sein de notre pharmacie, vous avez la possibilité de venir faire une téléconsultation via la plateforme Medadom.
      </h3>
    </div>
  </section>

  <!-- Contenido -->
  <section class="bg-white py-12 dark:bg-ink-900 lg:py-16">
    <div class="container-site grid gap-10 lg:grid-cols-2">
      <div class="space-y-5 text-[14px] leading-relaxed text-ink-600 dark:text-ink-300" data-aos="fade-up">
        <p class="font-bold text-ink-700 dark:text-ink-100">Service de télémédecine en pharmacie</p>
        <p>
          Notre pharmacie offre la possibilité de téléconsultations avec des médecins via la plateforme Medadom. Medadom vous met en relation avec des médecins généralistes et spécialistes en temps réel, sans avoir à attendre les rendez-vous traditionnels. La téléconsultation en pharmacie, c'est la consultation en ligne simple, où que vous soyez : la santé connectée au service de votre quotidien.
        </p>

        <div>
          <p class="font-bold text-ink-700 dark:text-ink-100">Avantages:</p>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>Accès immédiat aux soins médicaux : Consultez un médecin à distance sans attendre ni avoir à vous déplacer.</li>
            {avantages.slice(1).map((a) => <li>{a}</li>)}
          </ul>
        </div>

        <div>
          <p class="font-bold text-ink-700 dark:text-ink-100">Comment ça marche?</p>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            {etapes.map((e) => <li>{e}</li>)}
          </ul>
        </div>

        <div>
          <p class="font-bold text-ink-700 dark:text-ink-100">Zone de service?</p>
          <ul class="mt-3 list-disc space-y-1.5 pl-5">
            {zones.map((z) => <li class="font-bold text-ink-700 dark:text-ink-200">{z}</li>)}
          </ul>
        </div>

        <p>Medadom : La solution idéale pour obtenir des soins médicaux rapides, confortables et de qualité.</p>
      </div>

      <div class="flex items-start justify-center lg:justify-end" data-aos="fade-left">
        <img
          src="/images/2024/04/medadom-puymirol.jpg"
          alt="Cabine de téléconsultation Medadom installée dans la Pharmacie Puymirol"
          width="800"
          height="1200"
          loading="lazy"
          class="w-full max-w-[440px] object-contain"
        />
      </div>
    </div>
  </section>

  <!-- FAQ (contenu dérivé de la page; schema FAQPage pour Google) -->
  <section class="bg-gray-50 py-12 dark:bg-ink-800 lg:py-16" aria-label="Questions fréquentes">
    <div class="container-site max-w-4xl">
      <h2 class="text-center text-2xl font-bold text-ink-700 dark:text-ink-100 lg:text-3xl">Questions fréquentes</h2>
      <div class="mt-8 space-y-6 text-[14px] leading-relaxed text-ink-600 dark:text-ink-300">
        <div>
          <h3 class="text-[15px] font-bold text-ink-700 dark:text-ink-100">Comment se déroule une téléconsultation en pharmacie ?</h3>
          <p class="mt-2">
            Venez à la pharmacie et demandez une téléconsultation : notre personnel vous aide à entrer en contact avec un médecin via un appareil spécial. Vous expliquez votre problème, recevez un diagnostic et un traitement personnalisés, et le médecin peut vous prescrire des médicaments ou vous donner des instructions pour vos soins.
          </p>
        </div>
        <div>
          <h3 class="text-[15px] font-bold text-ink-700 dark:text-ink-100">Quels sont les avantages de la téléconsultation en pharmacie ?</h3>
          <p class="mt-2">
            Un accès immédiat aux soins médicaux sans déplacement, des soins sans rendez-vous pendant les heures d'ouverture de la pharmacie, une variété de spécialistes disponibles sur place et un service personnalisé de qualité.
          </p>
        </div>
        <div>
          <h3 class="text-[15px] font-bold text-ink-700 dark:text-ink-100">Quelles communes sont couvertes par le service ?</h3>
          <p class="mt-2">
            Le service couvre notamment Puymirol, Lafox, Tayrac, Grayssas, Perville, Casteljaloux, Saint-Urcisse, Saint-Romain-le-Noble et Saint-Caprais-de-Lerm.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BasePage>
