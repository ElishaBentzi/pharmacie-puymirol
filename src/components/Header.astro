---
import { pharmacyData } from '../data/store';

const navItems = [
  { href: '/', label: 'Accueil – Pharmacie Puymirol' },
  { href: '/teleconsultation', label: 'Téléconsultation' },
  { href: '/materiel-medical', label: 'Matériel Médical' },
  { href: '/orthopedie-et-contention', label: 'Orthopédie et Contention' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const normalize = (href: string) => (href === '/' ? '/' : href.replace(/\/$/, ''));
const { contact } = pharmacyData;
---

<!-- Header mínimo (opción 1: logo + nav + CTA teléfono; los datos completos viven solo en el footer) -->
<header class="sticky top-0 z-40 bg-white shadow-sm dark:bg-ink-800" role="banner">
  <div class="mx-auto flex h-20 w-full max-w-[1280px] items-center justify-between gap-4 px-4">
    <a href="/" class="flex-shrink-0" aria-label={`${pharmacyData.name} - Retour à l'accueil`}>
      <img
        src="/images/logos/logo-menu.png"
        alt="Pharmacie Puymirol"
        width="200"
        height="64"
        class="h-14 w-auto object-contain lg:h-16"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="hidden lg:block" aria-label="Navigation principale">
      <ul class="flex items-center gap-8" role="menubar">
        {navItems.map((item) => (
          <li role="none">
            <a
              href={item.href}
              role="menuitem"
              aria-current={normalize(currentPath) === normalize(item.href) ? 'page' : undefined}
              class:list={[
                'whitespace-nowrap font-archivo text-[13px] font-light tracking-wide transition-colors duration-200',
                'text-ink-600 hover:text-teal-600 dark:text-ink-200 dark:hover:text-teal-300',
                normalize(currentPath) === normalize(item.href) && 'text-teal-600 dark:text-teal-300 underline underline-offset-4',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <!-- Fax: número secundario, visible en pantallas anchas -->
      <a
        href={`tel:${contact.faxHref}`}
        class="hidden items-center gap-1.5 whitespace-nowrap text-[13px] text-ink-500 transition-colors hover:text-petrol-600 xl:flex dark:text-ink-300 dark:hover:text-teal-300"
        aria-label={`Fax de la pharmacie: ${contact.fax}`}
      >
        Fax {contact.fax}
      </a>
      <!-- CTA teléfono -->
      <a
        href={`tel:${contact.phoneHref}`}
        class="hidden items-center gap-2 whitespace-nowrap bg-coral-500 px-4 py-2.5 text-[14px] font-medium text-white transition-colors hover:bg-coral-600 sm:flex"
        aria-label={`Appeler la pharmacie au ${contact.phone}`}
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
        {contact.phone}
      </a>
      <a
        href={`tel:${contact.phoneHref}`}
        class="flex h-11 w-11 items-center justify-center bg-coral-500 text-white sm:hidden"
        aria-label={`Appeler la pharmacie au ${contact.phone}`}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
      </a>
      <!-- Facebook (junto al toggle de tema) -->
      <a
        href={contact.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-11 w-11 items-center justify-center text-petrol-600 transition-colors hover:text-[#1877F2] lg:hidden dark:text-teal-300 dark:hover:text-teal-200"
        aria-label="Facebook de la pharmacie"
      >
        <svg class="h-6 w-6" viewBox="0 0 320 512" fill="currentColor" aria-hidden="true"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
      </a>
      <a
        href={contact.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden h-9 w-9 items-center justify-center text-petrol-600 transition-colors hover:text-[#1877F2] lg:flex dark:text-teal-300 dark:hover:text-teal-200"
        aria-label="Facebook de la pharmacie"
      >
        <svg class="h-5 w-5" viewBox="0 0 320 512" fill="currentColor" aria-hidden="true"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
      </a>
      <button
        id="dark-toggle-mobile"
        class="flex h-10 w-10 items-center justify-center text-ink-600 lg:hidden dark:text-teal-300"
        aria-label="Basculer le mode sombre"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
      </button>
      <button
        id="dark-toggle"
        class="hidden h-9 w-9 items-center justify-center text-ink-400 hover:text-teal-600 lg:flex dark:text-ink-300 dark:hover:text-teal-300"
        aria-label="Basculer le mode sombre"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
      </button>
      <button
        id="menu-toggle"
        class="flex h-11 w-11 items-center justify-center bg-link text-white lg:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-gray-100 bg-white lg:hidden dark:border-ink-700 dark:bg-ink-800"
    aria-label="Navigation mobile"
  >
    <ul class="container-site py-2" role="menubar">
      {navItems.map((item) => (
        <li role="none">
          <a
            href={item.href}
            role="menuitem"
            aria-current={normalize(currentPath) === normalize(item.href) ? 'page' : undefined}
            class:list={[
              'block py-3 font-archivo text-[15px] font-light border-b border-gray-50 dark:border-ink-700',
              'text-ink-600 hover:text-teal-600 dark:text-ink-200 dark:hover:text-teal-300',
              normalize(currentPath) === normalize(item.href) && 'text-teal-600 dark:text-teal-300',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  for (const btn of document.querySelectorAll<HTMLButtonElement>('#dark-toggle, #dark-toggle-mobile')) {
    btn.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });
  }
</script>
