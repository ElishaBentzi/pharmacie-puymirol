---
import { pharmacyData } from '../data/store';
const { contact } = pharmacyData;
const charteHref = '/charte-de-protection-des-donnees-personnelles/';
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.fullAddress)}`;
---

<footer class="bg-ink-800 text-white dark:bg-ink-900" role="contentinfo">
  <div class="container-site py-14">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
      <!-- Datos de contacto con iconos grandes -->
      <div class="space-y-7">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <a href={`tel:${contact.phoneHref}`} class="group flex items-center gap-4">
            <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-petrol-600/30 text-teal-300 ring-1 ring-petrol-500/40 transition-all duration-300 group-hover:bg-petrol-600 group-hover:text-white">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
            </span>
            <span class="leading-tight">
              <span class="block text-[11px] uppercase tracking-widest text-white/50">Téléphone</span>
              <strong class="text-lg font-bold transition-colors group-hover:text-teal-300">{contact.phone}</strong>
            </span>
          </a>
          <a href={`tel:${contact.faxHref}`} class="group flex items-center gap-4">
            <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-petrol-600/30 text-teal-300 ring-1 ring-petrol-500/40 transition-all duration-300 group-hover:bg-petrol-600 group-hover:text-white">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9V4h12v5M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8" rx="1"/></svg>
            </span>
            <span class="leading-tight">
              <span class="block text-[11px] uppercase tracking-widest text-white/50">Fax</span>
              <strong class="text-lg font-bold transition-colors group-hover:text-teal-300">{contact.fax}</strong>
            </span>
          </a>
        </div>

        <a
          href={mapsHref}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4"
        >
          <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-petrol-600/30 text-teal-300 ring-1 ring-petrol-500/40 transition-all duration-300 group-hover:bg-petrol-600 group-hover:text-white">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
          </span>
          <span class="leading-tight">
            <span class="block text-[11px] uppercase tracking-widest text-white/50">Adresse</span>
            <strong class="text-lg font-bold transition-colors group-hover:text-teal-300">{contact.address}, {contact.zipCode} {contact.city}</strong>
          </span>
        </a>

        <div class="flex items-start gap-4">
          <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-petrol-600/30 text-teal-300 ring-1 ring-petrol-500/40">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg>
          </span>
          <div class="leading-relaxed pt-0.5">
            <span class="block text-[11px] uppercase tracking-widest text-white/50">Horaires</span>
            <p class="text-[15px]">
              <strong class="font-bold">Lun–Ven:</strong> 8:45 – 12:30 / 14:00 – 19:30<br />
              <strong class="font-bold">Mercredi:</strong> jusqu'à 19:00 · <strong class="font-bold">Samedi:</strong> 9:00 – 12:00
            </p>
          </div>
        </div>

        <a href={`mailto:${contact.emailHref}`} class="group flex items-center gap-4">
          <span class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-petrol-600/30 text-teal-300 ring-1 ring-petrol-500/40 transition-all duration-300 group-hover:bg-petrol-600 group-hover:text-white">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="m22 7-10 6L2 7"/></svg>
          </span>
          <span class="leading-tight">
            <span class="block text-[11px] uppercase tracking-widest text-white/50">Email</span>
            <strong class="text-lg font-bold transition-colors group-hover:text-teal-300">{contact.email}</strong>
          </span>
        </a>
      </div>

      <!-- Mapa interactivo -->
      <div class="flex justify-center lg:justify-end">
        <iframe
          src={`https://www.google.com/maps?q=${encodeURIComponent(contact.fullAddress)}&output=embed&hl=fr`}
          title={`Carte - ${pharmacyData.name}, ${contact.fullAddress}`}
          width="1024"
          height="562"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          class="h-[380px] w-full max-w-[560px] border-0"
        ></iframe>
      </div>
    </div>

    <p class="mt-10 text-center text-[13px]">
      <a href={charteHref} class="text-white/80 transition-colors hover:text-teal-300">Protection des Données Personnelles</a>
    </p>
  </div>
</footer>
