---
import { pharmacyData } from '../data/store';
const { contact } = pharmacyData;
const charteHref = '/charte-de-protection-des-donnees-personnelles/';
---

<footer class="bg-ink-700 dark:bg-ink-900 text-white" role="contentinfo">
  <div class="container-site py-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
      <!-- Columna info -->
      <div class="space-y-5 text-[14px] text-white">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <a href={`tel:${contact.phoneHref}`} class="flex items-center gap-3 text-white hover:text-teal-300 transition-colors">
            <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
            <strong class="font-bold">{contact.phone}</strong>
          </a>
          <a href={`tel:${contact.faxHref}`} class="flex items-center gap-3 text-white hover:text-teal-300 transition-colors">
            <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
            <strong class="font-bold">{contact.fax}</strong>
          </a>
        </div>

        <p class="flex items-center gap-3">
          <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
          <strong class="font-bold">{pharmacyData.name}</strong>&nbsp;{contact.address} {contact.zipCode} {contact.city}
        </p>

        <div class="flex items-start gap-3">
          <svg class="h-5 w-5 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg>
          <p class="leading-relaxed">
            <strong class="font-bold">Du Lundi au Vendredi:</strong>&nbsp; 8:45 – 12:30 / 14:00 – 19:30<br />
            <strong class="font-bold">Mercredi:</strong>&nbsp;jusqu'à 19:00<br />
            <strong class="font-bold">Samedi:</strong>&nbsp; 9:00 – 12:00
          </p>
        </div>

        <p class="font-bold pt-1">Fournisseurs</p>

        <a href={`mailto:${contact.emailHref}`} class="flex items-center gap-3 text-white hover:text-teal-300 transition-colors">
          <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="m22 7-10 6L2 7"/></svg>
          {contact.email}
        </a>
      </div>

      <!-- Columna mapa (enlazada a Google Maps) -->
      <div class="flex justify-center lg:justify-end">
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.fullAddress)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Voir sur Google Maps - ${pharmacyData.name}, ${contact.fullAddress}`}
          class="block transition-transform hover:scale-[1.02]"
        >
          <img
            src="/images/2018/05/map-1024x562.jpg"
            alt={`Carte - ${pharmacyData.name}, ${contact.fullAddress}`}
            width="1024"
            height="562"
            loading="lazy"
            class="w-full max-w-[520px] h-auto animate-float"
          />
        </a>
      </div>
    </div>

    <p class="mt-8 text-center text-[13px]">
      <a href={charteHref} class="text-white hover:text-teal-300 transition-colors">Protection des Données Personnelles</a>
    </p>
  </div>
</footer>

<style>
  /* Animación float del original (elementor-animation-float) */
  @media (prefers-reduced-motion: no-preference) {
    .animate-float {
      animation: footer-float 3s ease-in-out infinite;
    }
    @keyframes footer-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
  }
</style>
